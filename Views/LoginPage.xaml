<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProjectAysenur.Views.LoginPage"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="🐾" FontSize="80" HorizontalOptions="Center" />
        <Label Text="VetKlinik Yönetim" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <Entry Placeholder="Klinik E-posta" Keyboard="Email" Text="{Binding Email}" />
        <Entry Placeholder="Şifre" IsPassword="True" Text="{Binding Password}" />

        <Button Text="Sisteme Giriş Yap" 
                Command="{Binding LoginCommand}"
                BackgroundColor="DarkSlateBlue" 
                TextColor="White" 
                HeightRequest="50"
                CornerRadius="10"
                Margin="0,10,0,0"/>

        <Label Text="* Demo sürümü: Herhangi bir bilgiyle giriş yapabilirsiniz." 
               FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>