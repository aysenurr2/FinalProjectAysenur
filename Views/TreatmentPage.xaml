<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinalProjectAysenur.ViewModels"
             xmlns:model="clr-namespace:FinalProjectAysenur.Models"
             x:Class="FinalProjectAysenur.Views.TreatmentPage"
             Title="Yeni Tedavi"
             x:DataType="vm:TreatmentViewModel">
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="15" RowSpacing="10">
        
        <!-- Headers & Input -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Frame Padding="10" BackgroundColor="#E3F2FD" CornerRadius="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Hasta Seçimi" TextColor="Gray" FontSize="12"/>
                    <Picker Title="Hasta Seçiniz" 
                            ItemsSource="{Binding Pets}" 
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPet}"
                            TextColor="Black"/>
                </VerticalStackLayout>
            </Frame>
            
            <Frame Padding="10" BackgroundColor="#E3F2FD" CornerRadius="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Tarih" TextColor="Gray" FontSize="12"/>
                    <DatePicker Date="{Binding Date}" TextColor="Black"/>
                </VerticalStackLayout>
            </Frame>
            
            <Label Text="Yapılacak İşlemler:" FontAttributes="Bold" Margin="0,5,0,0"/>
        </VerticalStackLayout>

        <!-- Service List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableServices}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:ServiceItem">
                    <Frame Margin="0,3" Padding="10" CornerRadius="5" BorderColor="LightGray">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TreatmentViewModel}}, Path=ToggleServiceCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                <Label Text="{Binding Category}" FontSize="10" TextColor="Gray"/>
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:C}'}" VerticalOptions="Center" Margin="0,0,10,0"/>
                            
                            <!-- Simple Indicator for Selection -->
                            <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" IsEnabled="False" Color="#009688"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Footer: Total & Save -->
        <Frame Grid.Row="2" BackgroundColor="#E0F2F1" Padding="15" CornerRadius="10" BorderColor="#004D40">
            <VerticalStackLayout Spacing="10">
                
                <Entry Placeholder="Açıklama / Not (Opsiyonel)" Text="{Binding Description}" BackgroundColor="White"/>
                
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="TOPLAM TUTAR:" FontAttributes="Bold" VerticalOptions="Center" FontSize="16"/>
                    <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{0:C}'}" 
                           FontAttributes="Bold" FontSize="20" TextColor="#00695C"/>
                </Grid>
                
                <Button Text="KAYDET VE FİNANS'A İŞLE" 
                        Command="{Binding SaveTreatmentCommand}" 
                        BackgroundColor="#009688" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="8"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
