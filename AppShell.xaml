<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinalProjectAysenur.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FinalProjectAysenur.Views"
    Title="Veteriner Yönetim Sistemi"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Sahipler">
            <ShellContent 
                ContentTemplate="{DataTemplate views:OwnerPage}" 
                Route="OwnerPage" />
        </Tab>
        
        <Tab Title="Hastalar">
            <ShellContent 
        ContentTemplate="{DataTemplate views:MainPage}" 
        Route="MainPage" />
        </Tab>

        <Tab Title="Randevular">
            <ShellContent 
                ContentTemplate="{DataTemplate views:AppointmentPage}" 
                Route="AppointmentPage" />
        </Tab>
        
        <Tab Title="Tedavi">
             <ShellContent 
                ContentTemplate="{DataTemplate views:TreatmentPage}" 
                Route="TreatmentPage" />
        </Tab>

        <Tab Title="Finans">
            <ShellContent 
                ContentTemplate="{DataTemplate views:FinancePage}" 
                Route="FinancePage" />
        </Tab>
    </TabBar>

</Shell>